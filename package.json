{
  "name": "abr-parser",
  "version": "1.0.0",
  "description": "TypeScript library for parsing and writing Adobe Photoshop brush files (.abr)",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "import": "./src/index.ts",
      "require": "./src/index.ts",
      "types": "./src/index.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage"
  },
  "keywords": ["photoshop", "abr", "brush", "parser", "adobe"],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@babel/preset-env": "^7.29.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.2.1",
    "@types/pngjs": "^6.0.5",
    "jest": "^30.2.0",
    "pngjs": "^7.0.0",
    "ts-jest": "^29.4.6",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@types/uuid": "^10.0.0",
    "uuid": "^13.0.0",
    "zod": "^4.3.6"
  }
